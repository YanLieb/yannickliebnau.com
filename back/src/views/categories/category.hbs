<form id="category_form" class="form{{#if category}} category-form-update{{else}} category-form-new{{/if}}">
  <div class="form__name mb-4">
    <label for="category_name">Name</label>
    <input type="text" name="name" id="category_name" palceholder="Category Name" required {{#if
      category.name}}value="{{category.name}}" {{/if}} />
  </div>
  <div class="form__slug mb-4">
    <label for="category_slug">Slug</label>
    <input type="text" name="slug" id="category_slug" required {{#if category.slug}}value="{{category.slug}}" {{/if}} />
  </div>
  <div class="cateogory-form__submit">
    {{#if category.id}}
    <input type="hidden" name="id" id="project_id" value="{{category.id}}" />
    <input type="submit" value="Update" class="btn" />
    {{else}}
    <input type="submit" value="Save" class="btn" />
    {{/if}}
  </div>
</form>