<ol class="category-list">
  {{#if error}}
  <li class="category-list__empty text-center py-6">{{error}}</li>
  {{else}}
  <li class="category-list__header bg-slate-200 text-slate-600">
    <div class="category-list__header__container flex gap-2 p-3">
      <div class="category-list__header__title flex-2">Name</div>
      <div class="category-list__header__link flex-1">Actions</div>
    </div>
  </li>
  {{#each categories as |category|}}
  <li id="{{category._id}}" class="category-list__entry odd:bg-slate-100">
    <div class="category-list__entry__container flex items-center gap-2 px-3 py-2">
      <div class="category-list__entry__title flex-2">{{category.name}}</div>
      <div class="category-list__entry__link flex-1">
        <a class="btn flex-1" href="/categories/{{category.slug}}">Edit</a>
        <btn class="btn btn-danger delete-btn flex-1" data-id="{{category.id}}" href="/categories/{{category.slug}}">Delete
        </btn>
      </div>
    </div>
  </li>
  {{/each}}
  {{/if}}
</ol>