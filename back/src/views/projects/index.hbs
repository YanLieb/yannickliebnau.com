<ol class="project-list">
  {{#if error}}
  <li class="project-list__empty text-center py-6">{{error}}</li>
  {{else}}
    <li class="project-list__header bg-slate-200 text-slate-600">
      <div class="project-list__header__container flex gap-2 p-3">
        <div class="project-list__header__title flex-2">Title</div>
        <div class="project-list__header__link flex-1">Actions</div>
      </div>
    </li>
    {{#each projects as |project|}}
      <li id="{{project._id}}" class="project-list__entry odd:bg-slate-100">
        <div
          class="project-list__entry__container flex items-center gap-2 px-3 py-2"
        >
          <div class="project-list__entry__title flex-2">{{project.title}}</div>
          <div class="project-list__entry__link flex-1">
            <a class="btn flex-1" href="/projects/{{project.slug}}">Edit</a>
            <btn class="btn btn-danger delete-btn flex-1" data-id="{{project.id}}" href="/projects/{{project.slug}}">Delete</btn>
          </div>
        </div>
      </li>
    {{/each}}
  {{/if}}
</ol>